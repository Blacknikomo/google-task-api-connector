# Local development only. In AWS these come from Lambda env vars + Secrets Manager (see template.yaml).

# Public base URL of this server (no trailing slash). Used to build OAuth redirect URIs and metadata.
BASE_URL=http://localhost:3000

# Google OAuth 2.0 client (Web application type). Redirect URI must be ${BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DynamoDB table name (local: use dynamodb-local or an in-memory store, see src/auth/store.ts)
TOKEN_TABLE_NAME=google-tasks-connector-tokens

# Secret used to sign/encrypt tokens issued by this server to Claude (32+ random bytes, base64)
TOKEN_SIGNING_KEY=

# Optional allow-list of Google account emails permitted to use this connector (comma-separated)
ALLOWED_EMAILS=
